{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "outDir": "dist"
  },
  "include": [
    "tests/**/*.ts",
    "pageobjects/**/*.ts",
    "config/**/*.ts"
  ]
}