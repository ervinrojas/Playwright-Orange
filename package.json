{
  "name": "playwright-orange",
  "version": "1.0.0",
  "description": "Playwright E2E Test for OrangeHRM",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "report": "npx playwright show-report",
    "test:admin-setup": "npx playwright test --project=admin-setup",
    "test:employee-setup": "npx playwright test --project=employee-setup",
    "test:admin": "npx playwright test --project=admin",
    "test:employee": "npx playwright test --project=employee",
    "test:unauthenticated": "npx playwright test --project=unauthenticated",
    "test:ci": "npx playwright test --project=admin --project=employee --project=unauthenticated"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/ervinrojas/Playwright-Orange.git"
  },
  "keywords": ["playwright", "e2e", "testing", "automation", "typescript"],
  "author": "Ervin Rojas",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ervinrojas/Playwright-Orange/issues"
  },
  "homepage": "https://github.com/ervinrojas/Playwright-Orange#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2"
  }
}
